; Odoo configuration of a cell — rendered by setup.sh from .env into odoo-conf/odoo.conf
; (owner 101 = odoo, mode 600). Never edit the rendered file: the next run overwrites it.
[options]
db_host = odoo-db
db_port = 5432
db_user = odoo
db_password = {{ODOO_DB_PASSWORD}}
; One database per cell. No database manager: neither listing nor creating/dropping
; databases over the web (Caddy blocks /web/database as well).
; No db_name: with it the server would create the database itself on its first start,
; racing setup.sh, which creates it together with the login modules.
dbfilter = ^odoo$
list_db = False
admin_passwd = {{ODOO_MASTER_PASSWORD}}
; Behind Caddy: trust X-Forwarded-* (scheme, host) — otherwise redirect URIs say http.
proxy_mode = True
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/oca-addons
data_dir = /var/lib/odoo
; Threaded mode (workers = 0): one process, smallest footprint for a few users.
workers = 0
without_demo = all
