{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nolani Companion",
  "version": "0.5.15",
  "identifier": "de.nolanios.companion.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "onboarding",
        "title": "Nolani Companion",
        "url": "index.html",
        "width": 480,
        "height": 580,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nolani"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "externalBin": [
      "binaries/clarad"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Nolani Companion",
    "longDescription": "Connects this computer to your Nolani server.",
    "publisher": "Nolani",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": false
  }
}
